full['hour'] = full.index.hour      # Hora (0-23)
full['day'] = full.index.day        # Día del mes
full['month'] = full.index.month    # Mes
full['weekday'] = full.index.weekday  # Día de la semana (0 = lunes)

# OPCIONAL: Crear una columna de bloque horario (mañana, tarde, noche)
def bloque_hora(h):
    if 6 <= h < 12:
        return 'mañana'
    elif 12 <= h < 18:
        return 'tarde'
    elif 18 <= h < 24:
        return 'noche'
    else:
        return 'madrugada'

full['bloque'] = full['hour'].apply(bloque_hora)
